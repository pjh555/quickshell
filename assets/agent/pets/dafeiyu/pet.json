      "animation": "sleep",
      "wakeAnimation": "wake",
      "say": [
        "Zzz…"
      ],
      "wakeSay": [
        "唔…醒了醒了",
        "谁把我叫醒的？",
        "再睡五分钟…"
      ]
    },
    "ambient": [
